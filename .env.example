# LiveIPOTracker Environment Variables
# Copy this file to .env.local and populate with your credentials

# 1. Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase Service Role Key (Used strictly for server-side seed script and admin write jobs, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Site Discovery URL
NEXT_PUBLIC_SITE_URL=https://liveipotracker.in

# 3. Scheduled Crons Authorization
CRON_SECRET=your_long_random_cron_secret_token_here

# 4. Email Newsletter Dispatch (Optional: Resend or Brevo)
# Choose either Resend OR Brevo for 9 AM IST morning brief & double opt-in
RESEND_API_KEY=re_123456789...
# BREVO_API_KEY=xkeysib-...
EMAIL_FROM=LiveIPOTracker <alerts@liveipotracker.in>

# 5. Telegram Channel Bot Integration (Optional)
# Post new live bidding announcements to public or private Telegram channel
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ...
TELEGRAM_CHAT_ID=@your_telegram_channel_or_chat_id

# 6. Financial Modeling Prep (FMP) Global IPO API (Server-side ONLY)
FMP_API_KEY=

# 7. Finnhub Stock API (Server-side ONLY)
FINNHUB_API_KEY=
